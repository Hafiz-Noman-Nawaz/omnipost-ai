{
  "name": "@omnipost/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@omnipost/ai": "*",
    "@omnipost/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

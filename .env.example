# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Local Postgres from docker-compose.yml (host port 5434; 5432/5433 are taken on this machine)
DATABASE_URL=postgresql://omnipost:omnipost@localhost:5434/omnipost
# Session cookie secrets (regenerated per machine; see docs/05 §3)
AUTH_SECRET=
# AES-256-GCM key for platform OAuth tokens (required from Phase 7; secrets generated at scaffold time)
TOKEN_ENCRYPTION_KEY=

# --- AI providers (gemini, anthropic, openai, or mock) ---
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Worker (Phase 6) ---
WORKER_CONCURRENCY=5

# --- Platform OAuth (optional until Phase 7/8) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Storage (Phase 2; local driver) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/uploads

# --- Observability ---
LOG_LEVEL=info
